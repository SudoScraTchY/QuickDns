<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ApplicationIcon>QuickDNS.ico</ApplicationIcon>
        <PublishAot>False</PublishAot>
        <SignAssembly>False</SignAssembly>
        <Trimming>full</Trimming>
        <LangVersion>13</LangVersion>
        <AssemblyName>QuickDNSConsole</AssemblyName>
        <RootNamespace>QuickDNSConsole</RootNamespace>
        <Version>2.2.0</Version>
        <!-- Trims ICU and avoids globalization startup cost; the app formats
             fixed-pattern strings only. -->
        <InvariantGlobalization>true</InvariantGlobalization>

        <!-- Startup/runtime switches: this is a small short-lived-process-friendly
             console app, so several runtime services are dead weight. -->
        <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
        <StartupHookSupport>false</StartupHookSupport>
        <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
        <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
        <!-- AOT: prefer speed over size for the native build. -->
        <OptimizationPreference>Speed</OptimizationPreference>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <!-- Release-only trims: no debugger, no hot reload, no EventSource in prod builds. -->
        <DebuggerSupport>false</DebuggerSupport>
        <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
        <EventSourceSupport>false</EventSourceSupport>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Spectre.Console" Version="0.50.0" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="QD.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\QD.Core\QD.Core.csproj" />
    </ItemGroup>

</Project>
