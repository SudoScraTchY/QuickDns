<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ApplicationIcon>QuickDNS.ico</ApplicationIcon>
        <PublishAot>False</PublishAot>
        <SignAssembly>False</SignAssembly>
        <Trimming>full</Trimming>
        <LangVersion>13</LangVersion>
        <AssemblyName>QuickDNSConsole</AssemblyName>
        <RootNamespace>QuickDNSConsole</RootNamespace>
        <Version>2.1.0</Version>
        <!-- Trims ICU and avoids globalization startup cost; the app formats
             fixed-pattern strings only. -->
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Spectre.Console" Version="0.50.0" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="QD.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\QD.Core\QD.Core.csproj" />
    </ItemGroup>

</Project>
